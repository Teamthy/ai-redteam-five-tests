# Model to test (any OpenAI-compatible model id)
MODEL=gpt-4o-mini

# Endpoint. Pick one:
#   OpenAI      https://api.openai.com/v1
#   Ollama      http://localhost:11434/v1
#   LM Studio   http://localhost:1234/v1
#   Groq        https://api.groq.com/openai/v1
#   Together    https://api.together.xyz/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# API key. For local models (Ollama / LM Studio) any non-empty string works, e.g. ollama
OPENAI_API_KEY=

# Optional: path to a file holding YOUR real system prompt, to test your own bot
# instead of the built-in sample support bot.
# MY_SYSTEM_PROMPT_FILE=
